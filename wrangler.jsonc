{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compliance-agent",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./frontend/dist/frontend/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "PAGES_BUCKET",
      "bucket_name": "compliance-agent-pages"
    }
  ],
  "containers": [
    {
      "class_name": "ComplianceBackend",
      "image": "./backend/Dockerfile",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COMPLIANCE_BACKEND",
        "class_name": "ComplianceBackend"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ComplianceBackend"]
    }
  ],
  "ratelimits": [
    {
      "name": "GEMINI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
